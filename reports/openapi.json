{
  "openapi": "3.1.0",
  "info": {
    "title": "SONAR VISION",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions": {
      "post": {
        "summary": "Start Session",
        "operationId": "start_session_api_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Start Session Api Sessions Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}": {
      "get": {
        "summary": "Session State",
        "operationId": "session_state_api_sessions__session_id__get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Session State Api Sessions  Session Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Stop Session",
        "operationId": "stop_session_api_sessions__session_id__delete",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Stop Session Api Sessions  Session Id  Delete"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}/frame": {
      "get": {
        "summary": "Latest Frame",
        "operationId": "latest_frame_api_sessions__session_id__frame_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}/events": {
      "get": {
        "summary": "Session Events",
        "operationId": "session_events_api_sessions__session_id__events_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VisionEvent"
                  },
                  "title": "Response Session Events Api Sessions  Session Id  Events Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}/legacy": {
      "get": {
        "summary": "Legacy Events",
        "operationId": "legacy_events_api_sessions__session_id__legacy_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "title": "Response Legacy Events Api Sessions  Session Id  Legacy Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MatchStatus": {
        "type": "string",
        "enum": [
          "MATCH",
          "NON_MATCH",
          "UNCERTAIN"
        ],
        "title": "MatchStatus"
      },
      "SessionRequest": {
        "properties": {
          "route_requested": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Route Requested"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "mode": {
            "type": "string",
            "enum": [
              "real",
              "simulation"
            ],
            "title": "Mode",
            "default": "real"
          },
          "stop_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Stop Id",
            "default": "parada-piloto"
          },
          "waiting_session_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Waiting Session Id",
            "default": "espera-demo"
          },
          "fps": {
            "type": "number",
            "maximum": 15.0,
            "minimum": 0.5,
            "title": "Fps",
            "default": 5
          },
          "max_frames": {
            "type": "integer",
            "maximum": 1200.0,
            "minimum": 1.0,
            "title": "Max Frames",
            "default": 150
          },
          "max_seconds": {
            "type": "number",
            "maximum": 180.0,
            "minimum": 1.0,
            "title": "Max Seconds",
            "default": 30
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "route_requested"
        ],
        "title": "SessionRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VisionEvent": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "event_id": {
            "type": "string",
            "format": "uuid",
            "title": "Event Id"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "stop_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Stop Id"
          },
          "waiting_session_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Waiting Session Id"
          },
          "track_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Track Id"
          },
          "route_requested": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Route Requested"
          },
          "route_detected": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Route Detected"
          },
          "destination_detected": {
            "type": "null",
            "title": "Destination Detected"
          },
          "detection_confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Detection Confidence"
          },
          "ocr_confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Ocr Confidence"
          },
          "match_status": {
            "$ref": "#/components/schemas/MatchStatus",
            "default": "UNCERTAIN"
          },
          "frames_considered": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Frames Considered"
          },
          "supporting_frames": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Supporting Frames"
          },
          "source": {
            "type": "string",
            "enum": [
              "video_stream",
              "local_video",
              "simulation"
            ],
            "title": "Source"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "UNCERTAIN"
            ],
            "title": "Status"
          },
          "raw_texts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Raw Texts"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "simulated": {
            "type": "boolean",
            "title": "Simulated",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stop_id",
          "waiting_session_id",
          "track_id",
          "route_requested",
          "frames_considered",
          "supporting_frames",
          "source",
          "model_version",
          "status",
          "reason"
        ],
        "title": "VisionEvent"
      }
    }
  }
}